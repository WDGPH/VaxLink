{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "last-release-sha": "7f393327bd73ebe00515b13962e602905e95c4e8",
  "force-tag-creation": true,
  "bootstrap-sha": "e276a0eb845e35572feae0f7b66a8ee17c38d31d",
  "pull-request-title-pattern": "chore: release VaxLink ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "refactor", "section": "Changed", "hidden": true },
    { "type": "docs", "section": "Docs", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "extra-files": [
        { "type": "json", "path": "apps/extension/manifest.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/extension/manifest.json", "jsonpath": "$.version_name" }
      ]
    }
  }
}
