{
  "manifest_version": 3,
  "name": "VaxLink Alpha",
  "version": "1.0.9",
  "version_name": "1.0.9",
  "description": "Parse GS1 vaccine barcodes and auto-fill Panorama and web-based EMR platforms",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://nvc-cnv.canada.ca/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VaxLink Alpha",
    "default_icon": {
      "16": "assets/icon-16.png",
      "24": "assets/icon-24.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.panorama.prod.ehealthontario.ca/*",
        "https://panorama.prod.ehealthontario.ca/*",
        "https://inputhealth.com/*",
        "https://*.inputhealth.com/*"
      ],
      "js": [
        "content/platforms/panorama/agent-rules.js",
        "content/core/foundation.js",
        "content/scanner/scanner.js",
        "content/platforms/panorama/panorama.js",
        "content/platforms/dispatch.js",
        "content/ui/hud.js",
        "content/workflow/drain.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
