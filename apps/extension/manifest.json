{
  "manifest_version": 3,
  "name": "VaxLink Development",
  "version": "1.1.5",
  "version_name": "1.2.0-alpha",
  "description": "Parse GS1 vaccine barcodes and auto-fill Panorama",
  "permissions": ["storage", "alarms", "offscreen", "idle"],
  "minimum_chrome_version": "114",
  "host_permissions": ["https://nvc-cnv.canada.ca/*"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VaxLink Development",
    "default_icon": {
      "16": "assets/icon-16.png",
      "24": "assets/icon-24.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.panorama.prod.ehealthontario.ca/phsdsm/ImmsWeb/pages/recordImms/*",
        "https://www.panorama.prod.ehealthontario.ca/ImmsWeb/pages/recordImms/*",
        "https://panorama.prod.ehealthontario.ca/phsdsm/ImmsWeb/pages/recordImms/*",
        "https://panorama.prod.ehealthontario.ca/ImmsWeb/pages/recordImms/*",
        "https://trpanoramadhir.prod.ehealthontario.ca/phsdsm/ImmsWeb/pages/recordImms/*",
        "https://trpanoramadhir.prod.ehealthontario.ca/ImmsWeb/pages/recordImms/*"
      ],
      "js": [
        "build-info.js",
        "panorama-agent-rules.js",
        "shared/gs1-parser.js",
        "shared/expiry-date.js",
        "shared/vaccine-label.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
